# Phase 1 configuration (specs/02-architecture.md §5.7).
# Copy to .env.local to run locally. Use the same values on the Vercel deployment.

# Starts the MSW mock backend in the browser. `enabled` in Phase 1, also in production;
# `disabled` once the real backend exists (Phase 2).
NEXT_PUBLIC_API_MOCKING=enabled

# Base URL of the API. `/api` is answered by the mock backend in Phase 1;
# the real backend URL in Phase 2.
NEXT_PUBLIC_API_URL=/api

# Transport for live updates: `broadcast-channel` syncs tabs in Phase 1; `sse` in Phase 2.
NEXT_PUBLIC_REALTIME=broadcast-channel

# Error reporter: `console` logs locally in Phase 1 (§5.8); `sentry` in Phase 2.
NEXT_PUBLIC_MONITORING=console

# Sentry project DSN. Unused in Phase 1 (leave empty); required with `sentry` in Phase 2.
NEXT_PUBLIC_SENTRY_DSN=
